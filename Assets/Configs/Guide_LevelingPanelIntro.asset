  m_Script: {fileID: 11500000, guid: 390d48b7450cd4747b73af6494bb9519, type: 3}
  m_Name: Guide_LevelingPanelIntro
  m_EditorClassIdentifier: Assembly-CSharp::GuideDialogueSet
  lines:
  - "\u042D\u0442\u043E \u0442\u0432\u043E\u044F \u043F\u0430\u043D\u0435\u043B\u044C
    \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0438."
  - "\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u0432\u043B\u043E\u0436\u0438\u0442\u044C
    \u043E\u0447\u043A\u0438 \u0432 \u043E\u0434\u043D\u0443 \u0438\u0437 \u0442\u0440\u0451\u0445
    \u0432\u0435\u0442\u043E\u043A \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439
    \u2014 \u043E\u043D\u0438 \u0432\u0437\u0430\u0438\u043C\u043E\u0438\u0441\u043A\u043B\u044E\u0447\u0430\u044E\u0449\u0438\u0435,
    \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C."
  - "\u0410 \u0435\u0449\u0451 \u0435\u0441\u0442\u044C \u0434\u0432\u0430 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u0445
    \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u2014 \u0438\u0445 \u043C\u043E\u0436\u043D\u043E
    \u0431\u0440\u0430\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043B\u044E\u0431\u043E\u0439
    \u0432\u0435\u0442\u043A\u043E\u0439."
  - "\u0427\u0435\u043C \u0432\u044B\u0448\u0435 \u0442\u0432\u043E\u0439 \u0440\u0430\u043D\u0433,
    \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F."
